---
/**
 * Main Layout Component for Astro
 */
import Header from '../components/header/index.astro';
import Footer from '../components/Footer.astro';
import Margins from '../components/Margins.astro';
import '../styles/global.css';
import favicon from '../images/icon.png';

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="shortcut icon" href={favicon.src} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{(!title || title === 'Home') ? 'University of Michigan Library' : `${title} | University of Michigan Library`}</title>
    
    <script src="https://umich.edu/apis/umalerts/umalerts.js"></script>
    
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/@umich-lib/web@latest/dist/umich-lib/umich-lib.esm.js" as="script" />
    <script type="module" src="https://cdn.jsdelivr.net/npm/@umich-lib/web@latest/dist/umich-lib/umich-lib.esm.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/@umich-lib/web@latest/umich-lib.css" rel="stylesheet"/>
    <!--
      Override the @umich-lib/web design-system's global :focus rule.
      The design-system sets: outline:0; box-shadow: maize double-ring; border-radius:2px !important
      We restore the browser default outline colored with our site's brand blue,
      matching the Gatsby site's focus behavior (*:focus { outlineColor: var(--color-blue-400) }).
      This must be inline and after the CDN stylesheet so it wins in the cascade.
    -->
    <style is:inline>
      *:focus {
        box-shadow: none;
        border-radius: 0 !important;
        outline: revert;
        outline-color: var(--color-blue-400, #00274c);
      }
    </style>

  </head>
  <body>
    <div class="page-grid">
      <div>
        <section aria-label="Skip links" class="skip-links">
          <Margins>
            <ul>
              <li><a href="#maincontent">Skip to main content</a></li>
              <li><a href="#chat">Skip to Ask a Librarian chat</a></li>
              <li><a href="/site-map">View site map</a></li>
            </ul>
          </Margins>
        </section>
        
        <m-universal-header></m-universal-header>
      </div>
      
      <Header />
      <main id="maincontent">
        <slot />
      </main>
      
      <Footer />
    </div>
    
    <aside aria-label="Ask a Librarian Chat">
      <m-chat id="chat"></m-chat>
    </aside>

    <!-- <script>
      document.addEventListener("DOMContentLoaded", () => {
        const pageHeading =
          document.querySelector("[data-page-heading]") ??
          document.querySelector("h1");

        if (pageHeading instanceof HTMLElement) {
          pageHeading.tabIndex = -1;
          pageHeading.classList.add("focus");
          pageHeading.focus();
        }
      });
    </script> -->
    
    <style>
      /* Page Grid Layout */
      .page-grid {
        display: grid;
        grid-template-columns: 100%;
        grid-template-rows: auto auto 1fr auto;
        min-height: 100vh;
      }
      
      /* Skip Links Styles */
      .skip-links {
        background-color: var(--color-blue-400, #00274C);
        height: 1px;
        left: -10000px;
        overflow: hidden;
        position: absolute;
        top: auto;
        width: 1px;
      }

      .skip-links:focus-within {
        height: auto;
        padding: 1rem 0;
        position: static;
        width: auto;
      }

      .skip-links ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .skip-links li {
        text-align: center;
      }

      .skip-links li:not(:last-of-type) {
        margin-bottom: 1rem;
      }

      .skip-links a {
        color: white;
        padding: 0.5rem;
        text-decoration: underline;
      }

      .skip-links *:focus {
        outline-color: white;
      }
      
      /* Universal Header placeholder — shown before the web component upgrades */
      m-universal-header:not(:defined) {
        display: block;
        background-color: var(--color-blue-100, #CCE3F5);
        min-height: 37px;
      }
      
      main {
        flex: 1;
      }
    </style>
  </body>
</html>
