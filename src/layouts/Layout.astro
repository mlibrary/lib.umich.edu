---
/**
 * Main Layout Component for Astro
 */
import Header from '../components/header/index.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import favicon from '../images/icon.png';

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="shortcut icon" href={favicon.src} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{(!title || title === 'Home') ? 'University of Michigan Library' : `${title} | University of Michigan Library`}</title>
    
    <script src="https://umich.edu/apis/umalerts/umalerts.js"></script>
    
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/@umich-lib/web@latest/dist/umich-lib/umich-lib.esm.js" as="script" />
    <script type="module" src="https://cdn.jsdelivr.net/npm/@umich-lib/web@latest/dist/umich-lib/umich-lib.esm.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/@umich-lib/web@latest/umich-lib.css" rel="stylesheet"/>
    

  </head>
  <body>
    <div class="page-grid">
      <div>
        <section aria-label="Skip links" class="skip-links">
          <div class="margins">
            <ul>
              <li><a href="#maincontent">Skip to main content</a></li>
              <li><a href="#chat">Skip to Ask a Librarian chat</a></li>
              <li><a href="/site-map">View site map</a></li>
            </ul>
          </div>
        </section>
        
        <m-universal-header></m-universal-header>
      </div>
      
      <Header />
      <main id="maincontent">
        <slot />
      </main>
      
      <Footer />
    </div>
    
    <m-chat id="chat"></m-chat>

    <script>
      // focus management for UH skip links
      let initialLoad = true;

      document.addEventListener('astro:page-load', () => {
        if (initialLoad) {
          initialLoad = false;
          return;
        }

        const dataPageHeading = document.querySelector('[data-page-heading]');
        const h1 = document.querySelector('h1');
        const pageHeading = dataPageHeading ? dataPageHeading : h1;

        if (pageHeading) {
          pageHeading.setAttribute('tabindex', '-1');
          pageHeading.classList.add('focus');
          pageHeading.focus();
        }
      });
    </script>
    
    <style>
      /* Page Grid Layout */
      .page-grid {
        display: grid;
        grid-template-columns: 100%;
        grid-template-rows: auto auto 1fr auto;
        min-height: 100vh;
      }
      
      /* Skip Links Styles */
      .skip-links {
        background-color: var(--color-blue-400, #00274C);
        height: 1px;
        left: -10000px;
        overflow: hidden;
        position: absolute;
        top: auto;
        width: 1px;
      }

      .skip-links:focus-within {
        height: auto;
        padding: 1rem 0;
        position: static;
        width: auto;
      }

      .skip-links ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .skip-links li {
        text-align: center;
      }

      .skip-links li:not(:last-of-type) {
        margin-bottom: 1rem;
      }

      .skip-links a {
        color: white;
        padding: 0.5rem;
        text-decoration: underline;
      }

      .skip-links *:focus {
        outline-color: white;
      }
      
      /* Universal Header placeholder — shown before the web component upgrades */
      m-universal-header:not(:defined) {
        display: block;
        background-color: var(--color-blue-100, #CCE3F5);
        min-height: 37px;
      }
      
      main {
        flex: 1;
      }
    </style>
  </body>
</html>
