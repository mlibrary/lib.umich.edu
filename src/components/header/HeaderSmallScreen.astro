---
/**
 * Small Screen (Mobile) Header Component
 * Displays mobile navigation with collapsible menu
 */
import Logo from "./Logo.astro";
import Icon from "../../reusable/Icon.astro";
import SiteSearchModal from "./SiteSearchModal.astro";

interface Props {
  primary: any[];
  secondary: any[];
}

const { primary, secondary } = Astro.props;
---

<header class="header-small">
  <div class="margins">
    <div class="mobile-flex">
      <!-- Logo -->
      <div class="logo-mobile">
        <Logo size={32} />
      </div>

      <!-- Mobile Nav + Search -->
      <div class="mobile-actions">
        <SiteSearchModal />

        <button
          class="mobile-menu-toggle"
          aria-expanded="false"
          id="mobile-menu-toggle"
        >
          <Icon icon="menu" size={32} class="menu-icon menu-icon-open" />
          <Icon icon="close" size={32} class="menu-icon menu-icon-close" />
          <span class="visually-hidden">Navigation</span>
        </button>
      </div>
    </div>

    <!-- Mobile Dropdown Menu -->
    <nav class="mobile-nav" aria-label="Main and utility">
      <div class="mobile-dropdown" id="mobile-dropdown" hidden>
        {
          primary && primary.length > 0 && (
            <ul class="mobile-primary-nav">
              {primary.map((item, index) => {
                return (
                  <li class="mobile-primary-item">
                    {item.children && item.children.length > 0 ? (
                      <>
                        <button
                          class="mobile-primary-btn"
                          data-index={index}
                          aria-expanded="false"
                        >
                          <span>{item.text}</span>
                          <Icon icon="navigate_next" size={24} />
                        </button>
                        <div class="mobile-panel" hidden>
                          <ul>
                            {item.children.map((child) => {
                              return (
                                <li>
                                  <a href={child.to}>{child.text}</a>
                                </li>
                              );
                            })}
                          </ul>
                        </div>
                      </>
                    ) : (
                      <a href={item.to} class="mobile-primary-link">
                        {item.text}
                      </a>
                    )}
                  </li>
                );
              })}
            </ul>
          )
        }
        {
          secondary && secondary.length > 0 && (
            <nav aria-label="Utility navigation" class="mobile-secondary-nav">
              <ul>
                {secondary.map((item) => {
                  return (
                    <li>
                      <a href={item.to}>
                        {item.icon &&
                          (typeof item.icon === "string" ? (
                            <Icon icon={item.icon} size={20} />
                          ) : (
                            <Icon d={item.icon.d || item.icon} size={20} />
                          ))}
                        {item.text}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </nav>
          )
        }
        <!-- {
          tertiary && tertiary.length > 0 && (
            <nav aria-label="Tertiary navigation" class="mobile-tertiary-nav">
              <ul>
                {tertiary.map((item) => {
                  return (
                    <li>
                      <a href={item.to}>
                        {item.icon &&
                          (typeof item.icon === "string" ? (
                            <Icon icon={item.icon} size={20} />
                          ) : (
                            <Icon d={item.icon.d || item.icon} size={20} />
                          ))}
                        {item.text}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </nav>
          )
        } -->
      </div>
    </nav>
  </div>
</header>


<script>
  // Mobile menu toggle
  const mobileMenuToggle = document.getElementById("mobile-menu-toggle");
  const mobileDropdown = document.getElementById("mobile-dropdown");
  const menuIconOpen = mobileMenuToggle?.querySelector(
    ".menu-icon-open",
  ) as HTMLElement | null;
  const menuIconClose = mobileMenuToggle?.querySelector(
    ".menu-icon-close",
  ) as HTMLElement | null;

  const setMenuIconState = (expanded: boolean) => {
    if (menuIconOpen) {
      menuIconOpen.style.display = expanded ? "none" : "inline-block";
    }
    if (menuIconClose) {
      menuIconClose.style.display = expanded ? "inline-block" : "none";
    }
  };

  if (mobileMenuToggle && mobileDropdown) {
    // Ensure initial icon state is consistent.
    setMenuIconState(false);

    mobileMenuToggle.addEventListener("click", () => {
      const isExpanded =
        mobileMenuToggle.getAttribute("aria-expanded") === "true";
      const nextExpanded = !isExpanded;
      mobileMenuToggle.setAttribute("aria-expanded", String(nextExpanded));
      mobileDropdown.hidden = isExpanded;
      setMenuIconState(nextExpanded);
    });
  }

  // Mobile primary nav toggles
  const mobilePrimaryBtns = document.querySelectorAll(".mobile-primary-btn");
  mobilePrimaryBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const isExpanded = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!isExpanded));

      const panel = btn.nextElementSibling as HTMLElement;
      if (panel) {
        panel.hidden = isExpanded;
      }
    });
  });
</script>

<style>
  .header-small {
    display: block;
    border-bottom: 2px solid var(--color-neutral-100, #e0e0e0);
    background: white;
  }

  .mobile-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo-mobile {
    flex-shrink: 0;
  }

  .mobile-actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .mobile-menu-toggle {
    margin-right: -0.5rem;
  }

  .mobile-search-toggle,
  .mobile-menu-toggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 1rem 0.5rem;
    color: var(--color-blue-400, #00274c);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-menu-toggle .menu-icon-close {
    display: none !important;
  }

  .mobile-menu-toggle[aria-expanded="true"] .menu-icon-open {
    display: none !important;
  }

  .mobile-menu-toggle[aria-expanded="true"] .menu-icon-close {
    display: inline-block !important;
  }

  .mobile-search-toggle .material-icons,
  .mobile-menu-toggle .material-icons {
    font-size: 32px;
  }

  /* Mobile dropdown */
  .mobile-dropdown {
    background: white;
    border-top: solid 1px var(--color-neutral-100);
    box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 8px 0px;
    max-width: 84vw;
    position: absolute;
    right: calc(-1rem);
    width: 20rem;
    z-index: 101;
  }

  .mobile-nav {
    flex-shrink: 0;
  }

  .mobile-primary-nav {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-primary-item {
    border-bottom: 1px solid var(--color-neutral-100, #e0e0e0);
  }

  .mobile-primary-btn,
  .mobile-primary-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 1rem;
    background: none;
    border: none;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-blue-400, #00274c);
    text-decoration: none;
    text-align: left;
    cursor: pointer;
  }

  .mobile-primary-btn:hover,
  .mobile-primary-link:hover {
    background: var(--color-neutral-50, #f9f9f9);
    color: var(--color-teal-400, #0891b2);
  }

  .mobile-primary-btn svg {
    transition: transform 0.3s ease;
  }

  .mobile-primary-btn[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }

  .mobile-panel {
    background: var(--color-neutral-50, #f9f9f9);
  }

  .mobile-panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-panel a {
    display: block;
    padding: 0.75rem 1rem 0.75rem 2rem;
    color: var(--color-blue-400, #00274c);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .mobile-panel a:hover {
    background: white;
    color: var(--color-teal-400, #0891b2);
  }

  .mobile-secondary-nav {
    border-top: 2px solid var(--color-neutral-100, #e0e0e0);
    padding: 0.5rem 0;
  }

  .mobile-secondary-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-secondary-nav a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    color: var(--color-neutral-400, #666);
    text-decoration: none;
    font-size: 0.875rem;
  }

  .mobile-secondary-nav a:hover {
    background: var(--color-neutral-50, #f9f9f9);
    text-decoration: underline;
  }

  .mobile-secondary-nav .material-icons {
    font-size: 14px;
  }

  .mobile-menu-toggle:focus,
  .mobile-primary-btn:focus,
  .mobile-primary-link:focus,
  .mobile-panel a:focus,
  .mobile-secondary-nav a:focus {
    box-shadow: none;
    outline: none;
  }

  .mobile-menu-toggle:focus-visible,
  .mobile-primary-btn:focus-visible,
  .mobile-primary-link:focus-visible,
  .mobile-panel a:focus-visible,
  .mobile-secondary-nav a:focus-visible {
    box-shadow: none;
    outline: 1px auto;
    outline-color: var(--color-blue-400, #00274c);
    border-radius: 0;
  }

  @media (min-width: 1129px) {
    .header-small {
      display: none;
    }
  }
</style>
