---
/**
 * NoResults Component - Empty state with squirrel image
 * Converted from src/components/no-results.js
 *
 * Displays a "no results found" message with a decorative squirrel image.
 */
import Heading from '../reusable/Heading.astro';
import { Image } from 'astro:assets';
import squirrelImage from '../images/squirrel.png';
---

<div class="no-results">
  <div class="no-results-message" aria-live="assertive">
    <Heading size="L" level={2}>
      We couldn&rsquo;t find any results
    </Heading>
    <p class="no-results-text">
      <slot />
    </p>
  </div>
  <div class="squirrel-image-wrapper">
    <Image
      src={squirrelImage}
      alt=""
      width={526}
      class="no-results-image"
    />
  </div>
</div>

<style>
  .squirrel-image-wrapper{
    max-width: 16rem;
    margin: 0 auto;
  }

  .no-results {
    margin-bottom: 4rem;
    margin-top: 2.5rem;
  }

  @media (--bp-2xl-up) {
    .squirrel-image-wrapper {
      margin: 0;
    }

    .no-results {
      align-items: end;
      display: grid;
      column-gap: 3rem;
      grid-template-columns: 2fr 3fr;
    }
  }

  .no-results-message {
    margin: auto 0;
  }

  .no-results-text {
    font-size: 1.125rem;
    line-height: 1.5;
    margin-top: 0.5rem;
  }

  .no-results-image {
    display: inline-block;
    height: auto;
    margin: 1rem auto;
    max-width: 16rem;
  }

  @media (--bp-2xl-up) {
    .no-results-image {
      display: block;
      margin: 0;
      margin-bottom: 1.5rem;
      max-width: 100%;
      width: 100%;
    }
  }
</style>
