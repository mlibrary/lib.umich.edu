---
/*
 *
 * Renders an optimized Drupal image into Astro's <Image> component for
 * responsive display. Pass the real intrinsic width/height from Drupal
 * metadata so Astro can generate a proper srcset. Wrapper/img styles mirror
 * GatsbyImage output behavior. Default sizes are set to 920 x 100vw
 *
 */
import { Image } from 'astro:assets';

interface Props {
  src: string;
  alt: string;
  /** Intrinsic pixel width from Drupal file metadata */
  width?: number;
  /** Intrinsic pixel height from Drupal file metadata */
  height?: number;
  /** sizes attribute defaulting to gatsby sizes */
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src,
  alt,
  width = 920,
  height = 600,
  sizes = '(min-width: 920px) 920px, 100vw',
  loading = 'lazy',
  class: className,
} = Astro.props;

const wrapperClassName = className
  ? `gatsby-image-wrapper ${className}`
  : 'gatsby-image-wrapper';
---

{src && (
  <span class={wrapperClassName} style={`aspect-ratio: ${width} / ${height};`}>
    <Image
      src={src}
      alt={alt}
      width={width}
      height={height}
      format="webp"
      quality={75}
      sizes={sizes}
      loading={loading}
      decoding="async"
      class={className}
    />
  </span>
)}

<style>
  .gatsby-image-wrapper {
    display: block;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .gatsby-image-wrapper :global(img) {
    bottom: 0;
    height: 100%;
    left: 0;
    margin: 0;
    max-width: none;
    object-fit: cover;
    padding: 0;
    position: absolute;
    right: 0;
    top: 0;
    width: 100%;
  }
</style>
