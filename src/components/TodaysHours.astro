---
/**
 * TodaysHours - Display today's hours for a Drupal node
 * Converted from src/components/todays-hours.js
 *
 * Hours are computed client-side so the displayed time reflects
 * "now" in the user's session rather than the build time.
 */

interface Props {
  node: any;
}

const { node } = Astro.props;
import getHoursClientData from '../utils/hours-client-data';
---

<span class="hours-display" data-hours-node={JSON.stringify(getHoursClientData(node))}>…</span>

<script>
  import { displayHours } from '../utils/hours.js';

  const updateHoursDisplays = () => {
    document.querySelectorAll('.hours-display[data-hours-node]').forEach((el) => {
      try {
        const node = JSON.parse(el.getAttribute('data-hours-node') || '{}');
        const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/New_York' }));
        const hours = displayHours({ node, now });
        el.textContent = hours ? `TODAY: ${hours.text}` : 'TODAY: n/a';
      } catch {
        el.textContent = 'TODAY: n/a';
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateHoursDisplays);
  } else {
    updateHoursDisplays();
  }
</script>
