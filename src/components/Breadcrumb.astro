---
import Icon from '../reusable/Icon.astro';
import Link from '../reusable/Link.astro';

/**
 * Breadcrumb Component - Converted to Astro
 * Original: src/components/breadcrumb.js
 * 
 * Displays navigation breadcrumbs
 */

interface Props {
  data?: string;
  size?: 'default' | 'compact';
  [key: string]: any;
}

const { data, size = 'default', class: className = '', ...rest } = Astro.props;

// Parse breadcrumb data (provided as encoded JSON)
let parsedData: Array<{text: string, to?: string}> = [];

if (data) {
  try {
    parsedData = JSON.parse(data);
  } catch (e) {
    console.error('Failed to parse breadcrumb data:', e);
  }
}

// Don't render if no valid data
if (!parsedData || parsedData.length === 0) {
  return null;
}
---

<nav
  aria-label="Breadcrumb"
  class:list={[
    'breadcrumb',
    className,
    { 'breadcrumb--compact': size === 'compact' }
  ]}
  {...rest}
>
  <ol class="breadcrumb-list">
    {parsedData.map(({ text, to }, index) => (
      <li class="breadcrumb-item">
        {to ? (
          <Link href={to}>{text}</Link>
        ) : (
          <span class="breadcrumb-text">{text}</span>
        )}{index < parsedData.length - 1 && (
          <Icon icon='navigate_next' />
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumb {
    padding: 1.5rem 0;
  }

  @media (--bp-sm-up) {
    .breadcrumb {
      padding-bottom: 2rem;
      padding-top: 2.5rem;
    }

    .breadcrumb.breadcrumb--compact {
      padding-bottom: 1.5rem;
      padding-top: 1.5rem;
    }
  }
  
  .breadcrumb-list {
    list-style: none;
  }
  
  .breadcrumb-item {
    display: inline-block;
    margin-right: .25rem;
  }

  .breadcrumb-item > a{
    margin-right: .25rem;
  }
  
  .breadcrumb-text {
    color: var(--color-neutral-400);
  }
  
  .breadcrumb-separator {
    color: var(--color-neutral-300);
    user-select: none;
  }
</style>
