---
import IconText from './IconText.astro';
import Link from '../reusable/link.astro';
import getBuildingSlug from '../utils/get-building-slug';
import getFloor from '../utils/get-floor';
import createSlug from '../reusable/create-slug';

interface Props {
  node: any;
}

const { node } = Astro.props;

const isPageNode = node?.type === 'node--page';

const relationships = node?.relationships || {};
const attributes = node?.attributes || {};
const slug = node?.slug || attributes?.path?.alias || Astro.url.pathname;

const getFloorPlanHref = (plan: any): string | null => {
  return plan?.fields?.slug || plan?.slug || plan?.path?.alias || null;
};

const buildingNode = relationships?.field_room_building;
const parentLocationNode = relationships?.field_parent_location;
const locationNode = buildingNode
  ?? parentLocationNode?.relationships?.field_parent_location
  ?? node;

const buildingSlug = getBuildingSlug({ node });
const shouldDisplayHours = attributes?.field_display_hours_;
const locationTitle = parentLocationNode?.title ?? buildingNode?.title;
const phoneNumber = attributes?.field_phone_number;
const email = attributes?.field_email;
const floor = relationships?.field_floor ? getFloor({ node }) : null;
const roomNumber = attributes?.field_room_number
  ? `Room ${attributes.field_room_number}`
  : null;
const locationSummary = [locationTitle, floor, roomNumber]
  .filter((item) => typeof item === 'string')
  .join(', ');

const floorPlans = Array.isArray(relationships?.field_floor_plan)
  ? relationships.field_floor_plan
  : relationships?.field_floor_plan
    ? [relationships.field_floor_plan]
    : [];

const parentPageFloorPlan = relationships?.field_parent_page?.relationships?.field_floor_plan;
if (parentPageFloorPlan) {
  if (Array.isArray(parentPageFloorPlan)) {
    floorPlans.push(...parentPageFloorPlan);
  } else {
    floorPlans.push(parentPageFloorPlan);
  }
}

const floorPlan = floorPlans.find((plan: any) => getFloorPlanHref(plan)) || null;
const floorPlanHref = getFloorPlanHref(floorPlan);

const askLibrarian = slug === '/ask-librarian';
const floorPlanTargetText = [locationTitle, floor]
  .filter((item) => typeof item === 'string' && item.length > 0)
  .join(' ');

const hoursAnchorTitle = locationNode?.relationships?.field_parent_location?.title
  ?? locationNode?.title;
const hoursAnchor = hoursAnchorTitle
  ? `/locations-and-hours/hours-view#${createSlug(hoursAnchorTitle)}`
  : '/locations-and-hours/hours-view';

const hoursNodeData = JSON.stringify({
  field_display_hours_: shouldDisplayHours,
  field_hours_different_from_build: attributes?.field_hours_different_from_build,
  relationships: {
    field_hours_open: relationships?.field_hours_open,
    field_room_building: relationships?.field_room_building,
    field_parent_location: relationships?.field_parent_location,
  }
});
---

{!isPageNode && (
  <div class="location-info">
    {shouldDisplayHours && (
      <p>
        <IconText icon="access_time">
          <span>
            <span class="hours-display" data-hours-node={hoursNodeData}>...</span>
            <span class="block">
              <Link href={hoursAnchor}>View more hours</Link>
            </span>
          </span>
        </IconText>
      </p>
    )}

    {(floorPlanHref || askLibrarian) && (
      <p>
        <IconText icon="address">
          <span>
            {locationSummary}
            {buildingSlug && (
              <span class="block">
                <Link href={buildingSlug}>View building information</Link>
              </span>
            )}
            <span class="block">
              {askLibrarian
                ? 'Online'
                : floorPlanHref && (
                    <Link href={floorPlanHref}>
                      {floorPlanTargetText
                        ? `View the floor plan for ${floorPlanTargetText}`
                        : 'View floor plan'}
                    </Link>
                  )
              }
            </span>
          </span>
        </IconText>
      </p>
    )}

    {phoneNumber && (
      <p>
        <IconText icon="phone">
          <Link href={`tel:+1-${phoneNumber}`}>{phoneNumber}</Link>
        </IconText>
      </p>
    )}

    {email && (
      <p>
        <IconText icon="mail_outline">
          <Link href={`mailto:${email}`}>{email}</Link>
        </IconText>
      </p>
    )}
  </div>
)}

<style>
  .location-info {
    margin-bottom: var(--spacing-2xl);
  }

  .location-info > p:not(:last-child) {
    margin-bottom: var(--spacing-m);
  }

  .block {
    display: block;
  }
</style>