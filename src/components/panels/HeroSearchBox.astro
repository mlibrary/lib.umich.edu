---
import Icon from '../../reusable/Icon.astro';
import { getImage } from 'astro:assets';
import Margins from '../Margins.astro';

type Props = {
	data: any;
};

const { data } = Astro.props as Props;

// Determine background style (frosted white card)
const hasFrost = data?.field_background === 'white';

// Caption and alt text
const caption: string | null = data?.field_caption_text?.processed ?? null;
const altText: string = data?.relationships?.field_hero_images?.[0]?.field_media_image?.alt ?? '';

// Extract background images by orientation (adapted for Drupal JSON:API data structure)
const fieldHeroImages = data?.relationships?.field_hero_images ?? [];



const getSrcByOrientation = (orientation: string): string => {
	const node = fieldHeroImages.find((n: any) => n?.field_orientation === orientation);
	if (!node) return '';
	return node.fileUrl || '';
};

const getNodeByOrientation = (orientation: string): any =>
	fieldHeroImages.find((n: any) => n?.field_orientation === orientation) ?? null;

const targetHeight = (node: any, targetWidth: number): number | undefined => {
	if (node?.fileWidth && node?.fileHeight && node.fileWidth > 0) {
		return Math.round(node.fileHeight * (targetWidth / node.fileWidth));
	}
	return undefined;
};

const verticalCmsUrl = getSrcByOrientation('vertical');
const horizontalCmsUrl = getSrcByOrientation('horizontal');
const verticalNode = getNodeByOrientation('vertical');
const horizontalNode = getNodeByOrientation('horizontal');

const verticalSrc = verticalCmsUrl
	? (await getImage({
		src: verticalCmsUrl,
		format: 'webp',
		width: 1200,
		...(targetHeight(verticalNode, 1200) !== undefined
			? { height: targetHeight(verticalNode, 1200) }
			: { inferSize: true }),
	  })).src
	: '';
const horizontalSrc = horizontalCmsUrl
	? (await getImage({
		src: horizontalCmsUrl,
		format: 'webp',
		width: 1200,
		...(targetHeight(horizontalNode, 1200) !== undefined
			? { height: targetHeight(horizontalNode, 1200) }
			: { inferSize: true }),
	  })).src
	: '';
---

<Margins class="homepage-search-header">
	<section
		class="background-section"
		style={`--bg-vertical: url('${verticalSrc}'); --bg-horizontal: url('${horizontalSrc}');`}
	>
		<div class="hero-inner">
			<div class={`hero-card ${hasFrost ? 'frost' : ''}`}>
				<h1 id="help-find" class="hero-title">What can we help you find?</h1>

				{/* Search form (native elements replacing Input/Button/Icon) */}
				<form
					action="https://search.lib.umich.edu/everything"
					method="get"
					role="search"
					aria-labelledby="help-find"
					class="search-form"
				>
					<label for="library-search-query" class="search-label">
						Search our
						{' '}
						<a href="https://search.lib.umich.edu/catalog?utm_source=lib-home">catalog</a>,
						{' '}
						<a href="https://search.lib.umich.edu/articles?utm_source=lib-home">articles</a>, and more
					</label>

					<div class="search-row">
						<input id="library-search-query" name="query" type="search" class="search-input" />
						<input type="hidden" name="utm_source" value="lib-home" />
						<button type="submit" class="search-button">
							<Icon icon="search" size={20} style="color: #333;" />
							<span class="visually-hidden">Submit</span>
						</button>
					</div>
				</form>
			</div>
		</div>

		{/* Caption with visually hidden image for a11y context */}
		{caption && (
			<div class="caption frost" aria-hidden={altText ? 'false' : 'true'}>
				<figure>
					{altText && (
						<span class="visually-hidden">
							<span role="img" aria-label={altText}></span>
						</span>
					)}
					<figcaption>
						<div set:html={caption} />
					</figcaption>
				</figure>
			</div>
		)}
	</section>
</Margins>



<style>
	/* ── default (mobile-first) ───────────────────────── */
	@media (--bp-2xl-down) {
		.homepage-search-header {
			padding: 0 !important;
		}
	}

	.background-section {
		background-color: var(--color-neutral-100);
		background-image: var(--bg-vertical);
		background-position: center top 33%;
		background-repeat: no-repeat;
		min-height: 16rem;
		position: relative;
	}

	.hero-inner {
		display: block;
		min-height: 16rem;
	}

	.hero-card {
		background: transparent;
		margin: 0 auto;
		max-width: 28rem;
		padding: 1rem; /* SPACING.M */
	}

	.frost {
		backdrop-filter: blur(2px);
		background: rgba(255, 255, 255, 0.8);
	}

	.hero-title {
		font-size: 1.5rem;  /* TYPOGRAPHY.M */
		font-weight: 700;
		line-height: 1.25;  /* TYPOGRAPHY.M */
		margin: 0 auto 0.5rem; /* SPACING.XS */
		text-align: center;
	}

	.search-form {
		text-align: center;
	}

	/* ── MEDIA_QUERIES.S → 641px ──────────────────────── */

	@media (--bp-md-up) {
		.hero-card {
			padding: 1.5rem; /* SPACING.L */
		}
	}

	/* ── MEDIA_QUERIES.M → 720px ──────────────────────── */

	@media (--bp-lg-up) {
		.background-section {
			background-image: var(--bg-horizontal);
			background-position: center left 20%;
		}

		.hero-inner {
			align-items: center;
			display: flex;
		}

		.hero-card {
			border-radius: 2px;
			margin: 0;
			margin-left: 2.5rem; /* SPACING.2XL */
			max-width: 100%;
			padding: 2rem; /* SPACING.XL */
			width: 34rem;
		}

		.hero-title {
			font-size: 2rem;   /* TYPOGRAPHY.XL */
			font-weight: 800;  /* TYPOGRAPHY.XL */
			line-height: 1.25; /* TYPOGRAPHY.XL */
			max-width: 100%;
			padding: 0;
			text-align: left;
		}

		.search-form {
			text-align: left;
		}
	}

	/* ── MEDIA_QUERIES.L → 920px ──────────────────────── */

	@media (--bp-2xl-up) {
		.homepage-search-header {
			padding: 0 2.5rem; /* SPACING.2XL */
		}

		.background-section,
		.hero-inner {
			min-height: 25rem;
		}

		.hero-title {
			font-size: 2.25rem;
		}
	}

	/* ── form + caption (no breakpoint changes) ───────── */

	.search-label {
		display: block;
		padding-bottom: 0.5rem; /* SPACING.XS */
	}

	.search-label a {
		color: var(--color-neutral-400, #666);
		text-decoration: underline;
		text-decoration-thickness: 1px;
	}

	.search-label a:hover {
		text-decoration-thickness: 2px;
	}

	.search-row {
		align-items: flex-end;
		display: flex;
	}

	.search-input {
		appearance: textfield;
		border: solid 1px rgba(0, 0, 0, 0.5);
		border-radius: 4px;
		box-shadow: inset 0 1px 4px rgba(0, 0, 0, 0.1);
		font-family: inherit;
		font-size: 1rem;
		height: 40px;
		margin: 0;
		padding: 0.5rem 0.75rem;
		width: 100%;
	}

	.search-button {
		align-items: center;
		background: var(--color-maize-400);
		border-radius: 2px;
		color: inherit;
		display: flex;
		font-weight: 800;
		margin-left: 0.5rem; /* SPACING.XS */
		min-height: 2.5rem;
		padding: 0.5rem 1rem;
	}

	.search-button:hover,
	.search-button:focus {
		background: var(--color-maize-500);
	}

	.caption {
		border-radius: 2px 0 0 0;
		bottom: 0;
		max-width: min(90%, 40ch);
		padding: 0.25rem 0.75rem; /* SPACING.2XS + SPACING.S */
		position: absolute;
		right: 0;
	}

	.caption.frost figcaption :global(a) {
		color: var(--color-neutral-400);
		text-decoration: underline;
	}

	.caption.frost figcaption :global(a:hover) {
		box-shadow: inset 0 -2px var(--color-teal-400);
		text-decoration-thickness: 2px;
	}
</style>