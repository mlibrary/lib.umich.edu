---
/**
 * TemplateContent Component
 * Converted from src/components/aside-layout.js - TemplateContent
 *
 * Main content area in Template layout
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`template-content ${className}`}>
  <slot />
</div>

<style>
  .template-content {
    margin-bottom: 2rem;
  }

  @media (width >= 920px) {
    .template-content {
      grid-area: content;
    }
  }
</style>
