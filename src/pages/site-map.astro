---
/**
 * Site Map Page
 * Route: /site-map
 * Converted from src/pages/_site-map.jsx
 *
 * Displays the full navigation hierarchy sourced from Drupal
 * (/api/nav/primary and /api/nav/utility). This is distinct from
 * the SEO sitemap-index.xml generated by @astrojs/sitemap.
 * This is NOT the SEO sitemap, but the dedicated "site map" page for users.
 */
import Layout from '../layouts/Layout.astro';
import Margins from '../components/Margins.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Heading from '../reusable/Heading.astro';
import NestLinkedList from '../components/NestLinkedList.astro';
import { fetchPrimaryNav, fetchUtilityNav } from '../lib/drupal.js';

const [primary, secondary] = await Promise.all([
  fetchPrimaryNav(),
  fetchUtilityNav(),
]);

const breadcrumbData = JSON.stringify([
  { text: 'Home', to: '/' },
  { text: 'Site map' },
]);
---

<Layout title="Site map">
  <Margins>
    <Breadcrumb data={breadcrumbData} />

    <Heading size="3XL" level={1} class="site-map-title">
      Site map
    </Heading>

    <div class="site-map-lists">
      <Heading size="L" level={2} class="site-map-section-heading">
        Main navigation
      </Heading>
      <NestLinkedList data={primary} />

      <Heading size="L" level={2} class="site-map-section-heading">
        Utility navigation
      </Heading>
      <NestLinkedList data={secondary} />
    </div>
  </Margins>
</Layout>

<!--
  Styles use is:global because the cascade-dependent selectors need to
  reach into NestLinkedList's rendered <ol>/<li> elements.
  All rules are namespaced under .site-map-lists to avoid leaking.
-->
<style is:global>
  .site-map-title {
    margin-bottom: 1.5rem; 
  }

  .site-map-section-heading {
    margin-top: 2rem;
  }

  .site-map-lists > ol {
    list-style-type: decimal;
    margin-left: 1.5rem; 
  }

  @media (--bp-lg-up) {
    .site-map-lists > ol {
      columns: 2;
      column-gap: 2rem;
    }
  }

  @media (--bp-2xl-up) {
    .site-map-lists > ol {
      columns: 3;
    }
  }

  .site-map-lists ol li {
    break-inside: avoid;
    margin: 0.75rem 0.75rem 0.75rem 0; 
  }

  .site-map-lists > ol > li {
    margin-bottom: 3rem; 
  }

  .site-map-lists > ol > li > ol {
    list-style-type: lower-alpha;
    margin-left: 1.5rem;
  }

  .site-map-lists > ol > li > ol > li > ol {
    list-style-type: lower-roman;
    margin-left: 1.5rem;
  }

  .site-map-lists > ol > li > ol > li > ol ol {
    list-style-type: disc;
    margin-left: 1.5rem;
  }
</style>
